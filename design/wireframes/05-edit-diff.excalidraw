   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "There was a man sent from God, whose name was\nJohn. This man came for a witness, to bear witness\nof the Light, that all through him might believe.\nHe was not that Light, but was sent to bear\nwitness of that Light.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "There was a man sent from God, whose name was\nJohn. This man came for a witness, to bear witness\nof the Light, that all through him might believe.\nHe was not that Light, but was sent to bear\nwitness of that Light.",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 14
  },
