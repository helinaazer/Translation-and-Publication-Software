   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "There was a man sent by Allah whose name was\nYohanna. He came for testimony to testify to the\nlight, so that all would believe by his means. He\nwas not the light, but to testify to the light.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "There was a man sent by Allah whose name was\nYohanna. He came for testimony to testify to the\nlight, so that all would believe by his means. He\nwas not the light, but to testify to the light.",
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 14
  },
